<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_today"
                android:textColor="@color/deep_blue"
                android:textSize="28sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvLocationWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/location_info"
                android:textColor="@color/deep_blue_50"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans_medium" />

        </LinearLayout>

        <!-- AR Mode Banner -->
        <LinearLayout
            android:id="@+id/cardArMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_ar_mode_card"
            android:clickable="true"
            android:clipToOutline="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ar_icon_circle" />

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_view_in_ar"
                    android:tint="@color/white" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/ar_mode_title"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.75"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/ar_mode_subtitle"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.85"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="→"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Main content (padded) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Latest Snap Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/your_latest_snap"
                    android:textColor="@color/deep_blue"
                    android:textSize="20sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/btnSeeHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_history"
                    android:textColor="@color/gold_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold" />

            </LinearLayout>

            <!-- Last Capture Card -->
            <FrameLayout
                android:id="@+id/cardLastCapture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_24"
                android:clipToOutline="true"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgLastCapture"
                    android:layout_width="match_parent"
                    android:layout_height="182dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Last capture" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtLastCaptureName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/the_colosseum"
                            android:textColor="@color/deep_blue"
                            android:textSize="17sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_location_on"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/txtLastCaptureLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:textColor="@color/deep_blue_50"
                                android:textSize="12sp"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnViewDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_view_details_button"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/view_details"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Liked Places Section — full-width, horizontal slider -->
        <LinearLayout
            android:id="@+id/sectionLikedPlaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="24dp"
                android:text="@string/liked_places"
                android:textColor="@color/deep_blue"
                android:textSize="20sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="-0.01" />

            <!-- Horizontal slider — cards added programmatically -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/likedPlacesRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- bottom padding for nav bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>

</ScrollView>
