<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvScanLimitTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Limit Reached"
        android:textSize="18sp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/deep_blue"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/tvScanLimitMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/deep_blue_70"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4" />

    <TextView
        android:id="@+id/btnUpgrade"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_save_journal_button"
        android:gravity="center"
        android:text="Upgrade Plan"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/inter_semibold"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Maybe Later"
        android:textColor="@color/deep_blue_50"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        android:textAllCaps="false" />

</LinearLayout>
